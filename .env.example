# SmartCal Environment Configuration Example

# Backend Settings
PORT=8000
HOST=0.0.0.0
SECRET_KEY=smartcal_jwt_secret_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
MONGODB_URI=mongodb://localhost:27017/smartcal
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smartcal?retryWrites=true&w=majority
DB_NAME=smartcal

# AI Services
GEMINI_API_KEY=your_free_tier_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
